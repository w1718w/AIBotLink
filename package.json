{
  "name": "aibotlink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js",
    "install:dsh": "npm run build && node scripts/install-dsh-companion.mjs",
    "setup": "npm run build && node dist/main.js setup",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "qq-official-bot": "1.3.3",
    "qrcode": "1.5.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "axios": "1.20.0"
  }
}
